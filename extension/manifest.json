{
  "manifest_version": 3,
  "name": "英语录制节奏助手",
  "version": "0.1.0",
  "description": "让语录平台的录音控件保持可见，并精确提示红词后 5 秒与句末静音。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://bytedance.aiforce.cloud/app/*"
      ],
      "js": [
        "core.js",
        "dom.js",
        "overlay.css.js",
        "overlay.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}

